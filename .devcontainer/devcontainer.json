{
  "name": "Multi-Agent AI System",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "backend/main.py",
        "frontend/Home.py"
      ]
    },
    "vscode": {
      "settings": {
        "editor.formatOnSave": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "yzhang.markdown-all-in-one"
      ]
    }
  },
  "postCreateCommand": "sudo apt-get update && pip3 install --user -r backend/requirements.txt -r frontend/requirements.txt",
  "portsAttributes": {
    "8501": {
      "label": "Frontend (Streamlit)",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "Backend API (FastAPI)",
      "onAutoForward": "notify"
    }
  },
  "forwardPorts": [
    8501,
    8000
  ]
}
